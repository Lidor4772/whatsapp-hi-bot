{
  "name": "whatsapp-hi-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Auto-reply in Mordechai groups (Baileys, no browser)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "stop": "pkill -f 'node index.js' 2>/dev/null; exit 0",
