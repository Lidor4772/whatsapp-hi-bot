  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "6.7.24",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  }
}
